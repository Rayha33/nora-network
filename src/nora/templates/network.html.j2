<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>NORA network map</title>
<meta name="description" content="Interactive chart of the North Sea gas network: pipelines, terminals, flows and outages, with recorded data replayed as a live feed.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..700&family=Archivo+Narrow:wght@500;600&family=Newsreader:ital,opsz,wght@1,6..72,400..500&display=swap">
<style>{{ inline.vis_css|safe }}</style>
<style>{{ inline.css|safe }}</style>
</head>
<body>
<div id="map" class="map" role="application" aria-label="Chart of the North Sea gas network"></div>

<header class="bar">
  <a class="brand panel" id="brand" href="./">
    <span class="wordmark">NORA</span>
    <span class="tagline">North Sea gas network</span>
  </a>
  <div class="modes panel" role="tablist" aria-label="What the chart shows">
    <button type="button" role="tab" data-mode="network" aria-selected="true">Network</button>
    <button type="button" role="tab" data-mode="load" aria-selected="false">Load</button>
    <button type="button" role="tab" data-mode="risk" aria-selected="false">Risk</button>
    <button type="button" role="tab" data-mode="live" aria-selected="false" hidden>Live</button>
  </div>
  <label class="search panel">
    <span class="sr-only">Find an asset</span>
    <input id="search" list="asset-names" placeholder="Find an asset" autocomplete="off" spellcheck="false">
    <datalist id="asset-names"></datalist>
  </label>
  <div class="tools panel">
    <button type="button" class="icon" id="zoom-in" aria-label="Zoom in"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M3 8h10"/></svg></button>
    <button type="button" class="icon" id="zoom-out" aria-label="Zoom out"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10"/></svg></button>
    <button type="button" class="icon" id="zoom-fit" aria-label="Show the whole North Sea"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 6V2h4M10 2h4v4M14 10v4h-4M6 14H2v-4"/></svg></button>
    <button type="button" class="icon" id="theme" aria-label="Switch between day and night chart"><svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="5.5"/><path d="M8 2.5a5.5 5.5 0 0 1 0 11z" class="fill"/></svg></button>
  </div>
</header>

<details class="legend panel" id="legend" open>
  <summary>Key</summary>
  <div id="legend-body"></div>
</details>

<aside class="details panel" id="details" hidden aria-live="polite">
  <button type="button" class="icon close" id="details-close" aria-label="Close details"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8"/></svg></button>
  <div id="details-body"></div>
</aside>

<section class="player panel" id="player" hidden aria-label="Stream player">
  <button type="button" class="play" id="play" aria-label="Play">
    <svg viewBox="0 0 16 16" aria-hidden="true" class="when-paused"><path d="M5 3.5v9l7.5-4.5z"/></svg>
    <svg viewBox="0 0 16 16" aria-hidden="true" class="when-playing"><path d="M4.5 3.5h2.5v9H4.5zM9 3.5h2.5v9H9z"/></svg>
  </button>
  <div class="now">
    <div class="stream-name"><select id="stream-select" aria-label="Dataset"></select><span class="tag" id="stream-tag"></span></div>
    <time id="clock"></time>
  </div>
  <div class="track">
    <canvas id="spark" aria-hidden="true"></canvas>
    <input type="range" id="scrub" min="0" max="0" step="1" value="0" aria-label="Position in the stream">
  </div>
  <label class="speed"><span class="sr-only">Playback speed</span>
    <select id="speed">
      <option value="3600">1 hour per second</option>
      <option value="21600">6 hours per second</option>
      <option value="86400">1 day per second</option>
      <option value="1">Real time</option>
    </select>
  </label>
  <div class="total"><strong id="total">–</strong><span id="total-label">MSm³/d delivered</span></div>
</section>
<ol class="alarms" id="alarms" aria-live="polite" aria-label="Alarms"></ol>

<script>{{ inline.vis_js|safe }}</script>
<script>
var nodes = new vis.DataSet({{ nodes|tojson }});
var edges = new vis.DataSet({{ edges|tojson }});
var network = new vis.Network(document.getElementById("map"), { nodes: nodes, edges: edges }, {{ options|safe }});
var NORA = {{ nora|tojson }};
{{ inline.js|safe }}
</script>
</body>
</html>
